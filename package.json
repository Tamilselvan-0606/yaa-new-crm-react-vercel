    "@react-pdf/renderer": "^4.9.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-table": "^8.20.6",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
